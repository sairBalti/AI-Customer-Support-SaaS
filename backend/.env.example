# =============================================================================
# Backend environment template
# Copy to backend/.env and adjust. Never commit backend/.env.
# =============================================================================

# Application
APP_NAME=AI Customer Support Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2

# -----------------------------------------------------------------------------
# MySQL — pick the URL for HOW you run the API / Alembic on the host
#
# Host tooling + Docker Compose MySQL (default published port is 3307):
DATABASE_URL=mysql+aiomysql://user:password@localhost:3307/ai_customer_support
#
# Host tooling + a MySQL process listening on the machine's 3306:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/ai_customer_support
#
# Inside Docker Compose the backend service OVERRIDES this to the internal DNS:
# DATABASE_URL=mysql+aiomysql://user:password@mysql:3306/ai_customer_support
# (see docker-compose.yml — do not put the Docker hostname in backend/.env for host tools)
# -----------------------------------------------------------------------------
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# Redis
# Host tooling (Compose publishes Redis on localhost:6379):
REDIS_URL=redis://localhost:6379/0
#
# Inside Docker Compose the backend OVERRIDES this to:
# REDIS_URL=redis://redis:6379/0
# -----------------------------------------------------------------------------

# Vector store (local / free for development — do not require paid Pinecone)
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./.chroma
PINECONE_API_KEY=
PINECONE_INDEX=

# Object storage (local filesystem for development — no paid cloud required)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./.storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# LLM (optional; leave empty until AI features are implemented)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=http://localhost:5173

# Dev-only: allow X-User-Id / X-Company-Id / X-Super-Admin headers
AUTH_HEADER_BYPASS=false
