# Docker Compose variable defaults (copy to `.env` at the repo root).
# Used by docker-compose.yml — NOT the backend process env file.
# Backend app settings live in backend/.env (see backend/.env.example).

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ai_customer_support
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_PORT=3307

REDIS_PORT=6379
API_PORT=8000

APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
AUTH_HEADER_BYPASS=false
CORS_ORIGINS=http://localhost:5175,http://localhost:8080
