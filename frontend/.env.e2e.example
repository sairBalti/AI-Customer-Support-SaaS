# Local Playwright E2E environment (copy to frontend/.env.e2e — do not commit secrets)
#
# Prerequisites:
# 1. Docker stack healthy: `docker compose up -d` (backend :8000)
# 2. Fresh DB: `docker compose exec backend alembic upgrade head`
# 3. Backend LLM: LLM_PROVIDER=fake (default for local E2E)
# 4. Frontend base account must exist (local seed Super Admin):
#    email/password below — OR create via your ops script first.
#
# Run:
#   cd frontend
#   copy .env.e2e.example .env.e2e   # Windows
#   npm run test:e2e

E2E_FRONTEND_URL=http://127.0.0.1:5175
E2E_API_BASE_URL=http://127.0.0.1:8000

# Bootstrap Super Admin (required to seed role users)
E2E_SUPERADMIN_EMAIL=superadmin@platform.com
E2E_SUPERADMIN_PASSWORD=Str0ng!Password

# Shared password for seeded non-admin E2E users (created by global-setup)
E2E_PASSWORD=E2e!LocalPass12

E2E_COMPANY_ADMIN_EMAIL=e2e.company.admin@platform.com
E2E_SUPPORT_MANAGER_EMAIL=e2e.support.manager@platform.com
E2E_AGENT_EMAIL=e2e.agent@platform.com
E2E_CUSTOMER_EMAIL=e2e.customer@platform.com

# Dedicated FREE-plan Company Admin (upload size-limit E2E only)
E2E_FREE_ADMIN_EMAIL=e2e.free.admin@platform.com
E2E_COMPANY_SLUG=e2e-tenant

# Optional: force shared company id for seeded role users (defaults to Super Admin company)
# E2E_COMPANY_ID=1
