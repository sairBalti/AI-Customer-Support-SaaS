*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.logs

# Local durable data (local storage / vector)
.storage/
backend/.storage/
.chroma/
backend/.chroma/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc
*.log
.python-version
